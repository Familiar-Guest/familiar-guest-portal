# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (SMS / WhatsApp messaging, business phone number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Resend (transactional email + Supabase auth SMTP)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Stripe (payments — Checkout for owner-defined bookings)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Owner-offer feature
ADMIN_SECRET=                 # password gating /owner/offer
CRON_SECRET=                  # shared secret Vercel Cron sends to /api/cron/reminders
OWNER_AIRBNB_ICAL_URL=        # optional: Airbnb calendar export URL for conflict checks
NEXT_PUBLIC_SITE_URL=https://famguest.com

# Site admin portal (/admin) — set to the famguest.com owner's email
ADMIN_EMAIL=

